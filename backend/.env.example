DECISIONFORGE_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/decision_forge
DECISIONFORGE_ENVIRONMENT=production
DECISIONFORGE_API_PREFIX=/api
DECISIONFORGE_DEBUG=False
DECISIONFORGE_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
DECISIONFORGE_OPENAI_API_KEY=your-openai-api-key
DECISIONFORGE_GENERATION_API_KEY=replace-with-a-long-random-secret
DECISIONFORGE_GENERATION_ENABLED=True
DECISIONFORGE_GENERATION_COOLDOWN_SECONDS=15
DECISIONFORGE_MAX_GENERATIONS_PER_SESSION_PER_DAY=5
DECISIONFORGE_MAX_GENERATIONS_PER_DAY=20
DECISIONFORGE_SESSION_SECRET_KEY=replace-with-another-long-random-secret
DECISIONFORGE_SESSION_MAX_AGE_SECONDS=2592000
DECISIONFORGE_COOKIE_SECURE=True
DECISIONFORGE_QUALIFICATION_TIMEOUT_SECONDS=30
DECISIONFORGE_GENERATION_REQUEST_TIMEOUT_SECONDS=75
DECISIONFORGE_GENERATION_JOB_TIMEOUT_SECONDS=210
